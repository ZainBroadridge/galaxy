# Shared server configuration (Render + local API)
NODE_ENV=development
PORT=3001
CHAIN_ID=80002
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DB?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.neon.tech/DB?sslmode=require

# Use your existing Polygon Amoy Alchemy HTTPS endpoint for both ordinary RPC
# and alchemy_getAssetTransfers. No eth_getLogs block-range scan is used.
RPC_HTTP_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
RELAYER_PRIVATE_KEY=0xYOUR_TESTNET_RELAYER_PRIVATE_KEY
BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
ETHERSCAN_API_KEY=
VERIFY_CONTRACTS=true

# Public dApp origin used for direct links and automatic announcements.
WEB_APP_URL=https://YOUR_APP.vercel.app

# Browser origins allowed to call the API. Comma-separated.
CORS_ORIGINS=http://localhost:5173,https://YOUR_APP.vercel.app

# Private Cloudflare R2 bucket for optional proxy-voting PDFs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

SESSION_TTL_HOURS=24
AUTH_NONCE_TTL_MINUTES=10
MAX_EVENTS_PER_WALLET_PER_DAY=5

# Durable in-process job runner. It is part of the API web service.
JOB_LOCK_MINUTES=8
JOB_IDLE_DELAY_MS=1500
TRANSACTION_WAIT_TIMEOUT_MS=180000
CONFIRMATION_BLOCKS=8
ALCHEMY_PAGE_SIZE=1000
ALCHEMY_MAX_PAGES=100
ALCHEMY_MAX_RETRIES=6
