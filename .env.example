# Copy this file to .env for the API/worker processes. Never commit real values.

# -----------------------------------------------------------------------------
# Polygon Amoy
# -----------------------------------------------------------------------------
NODE_ENV=development
CHAIN_ID=80002
RPC_HTTP_URL=https://polygon-amoy.g.alchemy.com/v2/_AgUaQu51GLDoPeM-xUWI
# Must support historical eth_call and eth_getLogs at the requested record-date block.
RPC_ARCHIVE_URL=https://polygon-amoy.g.alchemy.com/v2/_AgUaQu51GLDoPeM-xUWI
BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
CONFIRMATION_BLOCKS=12
REORG_OVERLAP_BLOCKS=16

# -----------------------------------------------------------------------------
# Neon PostgreSQL
# DATABASE_URL: pooled URL for API and worker runtime traffic.
# DATABASE_URL_DIRECT: direct URL used only by migrations.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_PColMZU5qk4R@ep-mute-hill-avo8ukq1-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql://neondb_owner:npg_PColMZU5qk4R@ep-mute-hill-avo8ukq1.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# -----------------------------------------------------------------------------
# Render worker relayer
# Sponsors exactly one VoteEvent deployment per event and each final ballot.
# Never expose this key to Vite, Vercel, browser code, or GitHub.
# -----------------------------------------------------------------------------
RELAYER_PRIVATE_KEY=d8a21038271301bd6e1312c4de53a569948f82cbac3c7916d6827a4cff27f518
# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
PORT=3001
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=24
AUTH_NONCE_TTL_MINUTES=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
MAX_DEPLOYMENTS_PER_WALLET_PER_DAY=5

# -----------------------------------------------------------------------------
# Snapshot/indexer worker
# -----------------------------------------------------------------------------
WORKER_ID=local-worker-1
WORKER_POLL_INTERVAL_MS=1500
TRANSFER_LOG_CHUNK_SIZE=2500
VOTE_LOG_CHUNK_SIZE=2500
BALANCE_CALL_CONCURRENCY=16
MAX_SNAPSHOT_CANDIDATES=100000
TOKEN_SCAN_START_BLOCK=0
JOB_CONCURRENCY=3
JOB_LOCK_MINUTES=10
TRANSACTION_WAIT_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# Optional PolygonScan source verification
# -----------------------------------------------------------------------------
POLYGONSCAN_API_KEY=5SC65U3PP8824PK32ESND6CIS9BM2ZJGMK
VERIFY_CONTRACTS=true


# Browser origins allowed to call the API. Comma-separated.
CORS_ORIGINS=http://localhost:5173,https://YOUR_APP.vercel.app
SESSION_TTL_HOURS=24
AUTH_NONCE_TTL_MINUTES=10
MAX_EVENTS_PER_WALLET_PER_DAY=5

# Durable in-process job runner. It is part of the API web service.
JOB_LOCK_MINUTES=8
JOB_IDLE_DELAY_MS=1500
TRANSACTION_WAIT_TIMEOUT_MS=180000
CONFIRMATION_BLOCKS=8
ALCHEMY_PAGE_SIZE=1000
ALCHEMY_MAX_PAGES=100
ALCHEMY_MAX_RETRIES=6


