{
  "installCommand": "npm install --workspace ./apps/web --workspace ./packages/shared --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
